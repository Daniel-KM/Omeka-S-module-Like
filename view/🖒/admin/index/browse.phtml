<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \🖒\Api\Representation\LikeRepresentation[] $likes
 * @var array $query
 * @var \🖒\Form\QuickSearchForm $formSearch
 */

$plugins = $this->getHelperPluginManager();
$url = $plugins->get('url');
$i18n = $plugins->get('i18n');
$escape = $plugins->get('escapeHtml');
$assetUrl = $plugins->get('assetUrl');
$translate = $plugins->get('translate');
$hyperlink = $plugins->get('hyperlink');
$escapeAttr = $plugins->get('escapeHtmlAttr');

$this->headLink()
    ->appendStylesheet($assetUrl('css/common-quick-search.css', 'Common'));
$this->headScript()
    ->appendFile($assetUrl('js/common-quick-search.js', 'Common'), 'text/javascript', ['defer' => 'defer']);

$this->htmlElement('body')->appendAttribute('class', 'like likes browse');
?>

<?= $this->pageTitle('', 1, $translate('Likes')) ?>

<div class="browse-controls">
    <?= $p = $this->pagination() ?>
    <button type="button" class="button search quick-search"><?= $escape($translate('Quick filter')) ?></button>
</div>

<?php $this->trigger('view.browse.before'); ?>

<?php if (count($likes)): ?>

<table class="tablesaw" data-tablesaw-mode="stack">
    <thead>
        <tr>
            <th><?= $translate('Resource') ?></th>
            <th><?= $translate('User') ?></th>
            <th><?= $translate('Status') ?></th>
            <th><?= $translate('Created') ?></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($likes as $like):
            // A vote belongs either to a user or to an anonymous visitor.
            $owner = $like->owner();
            $resource = $like->resource();
            ?>
        <tr>
            <td>
                <?php if ($resource): ?>
                    <?= $hyperlink($resource->displayTitle(), $resource->adminUrl()) ?>
                <?php else: ?>
                    <em><?= $translate('[Deleted resource]') ?></em>
                <?php endif; ?>
            </td>
            <td>
                <?php if ($owner): ?>
                    <?= $hyperlink($owner->name(), $owner->adminUrl()) ?>
                <?php elseif ($like->isAnonymous()): ?>
                    <em><?= $translate('Anonymous') ?></em>
                <?php else: ?>
                    <em><?= $translate('[Deleted user]') ?></em>
                <?php endif; ?>
            </td>
            <td>
                <?php if ($like->liked()): ?>
                    <span class="like-status liked"><span class="fa fa-thumbs-up"></span> <?= $translate('Liked') ?></span>
                <?php else: ?>
                    <span class="like-status disliked"><span class="fa fa-thumbs-down"></span> <?= $translate('Disliked') ?></span>
                <?php endif; ?>
            </td>
            <td><?= $i18n->dateFormat($like->created(), 'medium', 'medium') ?></td>
            <td>
                <?= $hyperlink('', '#', [
                    'class' => 'o-icon-delete sidebar-content',
                    'title' => $translate('Delete'),
                    'data-sidebar-selector' => '#sidebar',
                    'data-sidebar-content-url' => $url('admin/like-id', ['action' => 'delete-confirm', 'id' => $like->id()]),
                ]) ?>
            </td>
        </tr>
        <?php endforeach; ?>
    </tbody>
</table>

<?php else: ?>

<p><?= $translate('No ❤️ found.') ?></p>

<?php endif; ?>

<?php $this->trigger('view.browse.after'); ?>

<div class="browse-controls">
    <?= $p ?>
</div>

<div id="sidebar" class="sidebar">
    <?= $hyperlink('', '#', [
        'class' => 'sidebar-close o-icon-close',
        'title' => $translate('Close'),
    ]) ?>
    <div class="sidebar-content"></div>
</div>

<?= $this->partial('common/quick-search-sidebar', [
    'formSearch' => $formSearch,
    'title' => $translate('Filter likes'),
]) ?>
