<?php
/**
 * Advanced search partial for like filter.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array $query Current search query
 */

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');

$likeStatus = $query['like_status'] ?? '';
$hasLikes = $query['has_likes'] ?? '';
?>

<div class="field">
    <div class="field-meta">
        <span class="label"><?= $escape($translate('Has likes')) ?></span>
    </div>
    <div class="inputs">
        <label class="type-radio"><input type="radio" name="has_likes" value=""<?= $hasLikes === '' ? ' checked' : '' ?>> <?= $escape($translate('All')) ?></label>
        <label class="type-radio"><input type="radio" name="has_likes" value="1"<?= $hasLikes === '1' ? ' checked' : '' ?>> <?= $escape($translate('Yes')) ?></label>
        <label class="type-radio"><input type="radio" name="has_likes" value="0"<?= $hasLikes === '0' ? ' checked' : '' ?>> <?= $escape($translate('No')) ?></label>
    </div>
</div>

<div class="field">
    <div class="field-meta">
        <span class="label"><?= $escape($translate('Like status')) ?></span>
    </div>
    <div class="inputs">
        <label class="type-radio"><input type="radio" name="like_status" value=""<?= $likeStatus === '' ? ' checked' : '' ?>> <?= $escape($translate('All')) ?></label>
        <label class="type-radio"><input type="radio" name="like_status" value="liked"<?= $likeStatus === 'liked' ? ' checked' : '' ?>> <?= $escape($translate('Liked by me')) ?></label>
        <label class="type-radio"><input type="radio" name="like_status" value="disliked"<?= $likeStatus === 'disliked' ? ' checked' : '' ?>> <?= $escape($translate('Disliked by me')) ?></label>
        <label class="type-radio"><input type="radio" name="like_status" value="voted"<?= $likeStatus === 'voted' ? ' checked' : '' ?>> <?= $escape($translate('Voted by me')) ?></label>
        <label class="type-radio"><input type="radio" name="like_status" value="not_voted"<?= $likeStatus === 'not_voted' ? ' checked' : '' ?>> <?= $escape($translate('Not voted by me')) ?></label>
    </div>
</div>
